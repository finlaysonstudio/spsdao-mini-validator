{
  "name": "@spsdao/mini-validator-repo",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rimraf ./packages/*/dist",
    "dev": "npm run dev --workspace packages/validator",
    "format": "npm run format:package && npm run format:lint",
    "format:lint": "eslint --fix .",
    "format:package": "sort-package-json ./package.json ./packages/*/package.json",
    "lint": "eslint --quiet .",
    "sort": "sort-package-json ./package.json ./packages/*/package.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@jaypie/eslint": "^1.2.2",
    "@jaypie/testkit": "^1.2.24",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.3",
    "rimraf": "^6.1.3",
    "sort-package-json": "^3.6.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
