#!/bin/sh
# spud: manage a Spud (SPS mini validator) installation. Written to <dir>/bin/spud by install.sh, which also
# records the install settings in <dir>/install.conf; `spud update` re-runs the release's installer.
set -eu

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
usage: spud [<command>] [args]

  (none)                       status, then a pointer to this list
  status                       state, role, uptime, block and sync, release, upstream version, updates
  logs [-f] [-n N]             validator logs (-f follows)
  start | stop | restart       control the service
  accounts                     configured validator accounts and how many keys are set
  add [<account>] [<key>]      add a validator account and restart; asks for the account and posting
                               key when not given (Escape or Ctrl-C cancels)
  add [<account>] --no-key     add the account without asking for a key
  remove <account>             remove a validator account and restart
  snapshot                     list snapshots, where they are written and when the next one is due
  snapshot now                 export a snapshot now from the newest checkpoint
  config                       edit .env; restarts when it changed
  version                      installed release and validator version
  update [--version TAG]       reinstall from the latest (or given) release with its installer
  update --check               report whether a newer release exists
  update --auto                update to the latest release if newer, check it and roll back on failure
                               (what the daily auto-update runs)
  auto-update [on|off]         show, turn on or turn off the daily auto-update
  uninstall [--purge]          remove the service and spud; --purge also deletes the install directory
  help                         this list
EOF
}

# ------------------------------------------------------------------ locate the install
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
DIR=${SPUD_DIR:-$(cd "$(dirname "$self")/.." && pwd)}
[ -f "$DIR/install.conf" ] || die "no install.conf in $DIR (set SPUD_DIR to the install directory)"
# Written by install.sh: MODE SERVICE REPO TAG IMAGE RELEASE_BASE BIN LABEL PLIST UNIT
. "$DIR/install.conf"
ENV="$DIR/.env"
STATE_DIR="$DIR/state"
UID_=$(id -u)

env_get() { sed -n "s/^$1=//p" "$ENV" | tail -n 1; }

# env_set NAME: set NAME to $SPUD_VALUE in .env (the value never appears on a command line).
env_set() {
  tmp="$ENV.tmp.$$"
  (umask 077 && awk -v k="$1" '
    BEGIN { v = ENVIRON["SPUD_VALUE"]; done = 0 }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$ENV" > "$tmp")
  mv "$tmp" "$ENV"
}

list_has() { case ",$1," in *",$2,"*) return 0 ;; esac; return 1; }
list_count() { if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | tr ',' '\n' | grep -c .; fi; }

# ------------------------------------------------------------------ service control
dc() { (cd "$DIR" && docker compose --progress quiet "$@"); }
launchd_loaded() { launchctl print "gui/$UID_/$LABEL" >/dev/null 2>&1; }

svc_start() {
  case "$SERVICE" in
    docker) dc up -d ;;
    systemd) systemctl --user start "$UNIT" ;;
    launchd) launchd_loaded && launchctl kickstart "gui/$UID_/$LABEL" || launchctl bootstrap "gui/$UID_" "$PLIST" ;;
    *) die "no service manager; run $DIR/run.sh" ;;
  esac
}

svc_stop() {
  case "$SERVICE" in
    docker) dc stop ;;
    systemd) systemctl --user stop "$UNIT" ;;
    launchd) launchctl bootout "gui/$UID_/$LABEL" 2>/dev/null || true ;;
    *) die "no service manager; stop $DIR/run.sh yourself" ;;
  esac
}

svc_restart() {
  case "$SERVICE" in
    docker) dc up -d --force-recreate ;;
    systemd) systemctl --user restart "$UNIT" ;;
    launchd) if launchd_loaded; then launchctl kickstart -k "gui/$UID_/$LABEL"; else launchctl bootstrap "gui/$UID_" "$PLIST"; fi ;;
    *) die "no service manager; restart $DIR/run.sh yourself" ;;
  esac
}

svc_state() {
  case "$SERVICE" in
    docker)
      s=$(docker inspect -f '{{.State.Status}} (since {{.State.StartedAt}})' spudsps 2>/dev/null) || s="not created"
      echo "$s" ;;
    systemd) systemctl --user is-active "$UNIT" 2>/dev/null || true ;;
    launchd)
      if launchd_loaded; then launchctl print "gui/$UID_/$LABEL" | sed -n 's/^[[:space:]]*state = //p' | head -n 1
      else echo "not loaded"; fi ;;
    *) echo "unmanaged" ;;
  esac
}

# Restart without progress output; show it only when the restart fails.
quiet_restart() {
  out=$(svc_restart 2>&1) || { printf '%s\n' "$out" >&2; die "restart failed"; }
}

# Restart and report, for each account, the startup line the validator writes to duties.log.
restart_and_report() {
  log="$STATE_DIR/duties.log"
  before=0
  [ -f "$log" ] && before=$(wc -l < "$log")
  quiet_restart
  say "Restarted; waiting for the validator to check posting authority"
  pending=$*
  i=0
  while [ -n "$pending" ] && [ $i -lt 180 ]; do
    still=""
    for a in $pending; do
      line=$(tail -n "+$((before + 1))" "$log" 2>/dev/null | grep "\"account\":\"$a\"" | grep -E '"msg":"(posting authority verified|validator account skipped)"' | tail -n 1 || true)
      case "$line" in
        "") still="$still $a" ;;
        *verified*) say "$a: ready (via $(printf '%s' "$line" | sed -n 's/.*"via":"\([^"]*\)".*/\1/p'))" ;;
        *) warn "$a: skipped: $(printf '%s' "$line" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')" ;;
      esac
    done
    pending=$still
    [ -n "$pending" ] || break
    sleep 1
    i=$((i + 1))
  done
  [ -z "$pending" ] || warn "no startup report yet for:$pending (spud logs)"
}

# ------------------------------------------------------------------ commands
cmd_status() {
  f="$STATE_DIR/status.json"
  [ -s "$f" ] || f=""
  state=$(svc_word)
  role=${f:+$(json_str role "$f")}
  delay=${f:+$(json_num validate_block_delay "$f")}
  case "$role" in
    follower) role_text=" as follower (${delay:-?} block delay)" ;;
    *) role_text="" ;;
  esac
  [ "$state" = running ] || role_text=""
  row Status "$state$role_text"
  started=${f:+$(json_num started_unix "$f")}
  if [ "$state" = running ] && [ -n "$started" ]; then row Uptime "$(duration $(($(date +%s) - started)))"
  else row Uptime "-"; fi
  accounts=$(env_get VALIDATOR_ACCOUNTS)
  row Accounts "${accounts:-none}"
  row Block "$(block_summary)"
  row Head "$(head_summary)"
  row Release "$TAG"
  upstream=${f:+$(json_str upstream_version "$f")}
  row Version "$([ -n "$upstream" ] && echo "v$upstream" || echo unknown)"
  row Update "$(update_summary)"
  row Checked "$(checked_summary)"
}

row() { printf '%-10s%s\n' "$1" "$2"; }

# running, stopped or unmanaged, whatever the service manager calls it.
svc_word() {
  case "$(svc_state)" in
    running*|active) echo running ;;
    unmanaged) echo unmanaged ;;
    *) echo stopped ;;
  esac
}

# duration <seconds>: 2d 3h, 4h 12m, 5m 3s
duration() {
  awk -v s="$1" 'BEGIN {
    d = int(s / 86400); h = int(s % 86400 / 3600); m = int(s % 3600 / 60)
    if (d > 0) printf "%dd %dh\n", d, h; else if (h > 0) printf "%dh %dm\n", h, m; else printf "%dm %ds\n", m, s % 60
  }'
}

# Blocks behind head that still count as caught up (~1 minute of chain time).
SYNC_CAUGHT_UP_BLOCKS=20
# A status file older than this means the validator is not advancing.
SYNC_STALE_SECONDS=120

json_num() { sed -n "s/.*\"$1\":\([0-9.]*\).*/\1/p" "$2"; }
json_str() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$2"; }

# sync_state: sets head, behind, rate and sync (caught_up, catching_up, stalled, loading, unknown) from status.json.
sync_state() {
  f="$STATE_DIR/status.json"
  head="" behind="" rate="" age=0
  [ -s "$f" ] || { sync=unknown; return; }
  head=$(json_num head_block "$f")
  behind=$(json_num behind "$f")
  rate=$(json_num rate "$f")
  [ -n "$head" ] || { sync=loading; return; }
  mtime=$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f")
  age=$(($(date +%s) - mtime))
  if [ "$age" -gt "$SYNC_STALE_SECONDS" ]; then sync=stalled
  elif [ "$behind" -le "$SYNC_CAUGHT_UP_BLOCKS" ]; then sync=caught_up
  else sync=catching_up; fi
}

# The last processed block, its age and whether the validator is caught up to the chain head.
block_summary() {
  hashes="$STATE_DIR/hashes.log"
  if [ -s "$hashes" ]; then
    block=$(tail -n 1 "$hashes" | cut -d' ' -f1)
    mtime=$(stat -c %Y "$hashes" 2>/dev/null || stat -f %m "$hashes")
    printf '%s (%ss ago), %s\n' "$block" "$(($(date +%s) - mtime))" "$(sync_summary)"
  else
    printf 'none yet, %s\n' "$(sync_summary)"
  fi
}

sync_summary() {
  sync_state
  case "$sync" in
    unknown) echo "sync unknown (no status.json yet)" ;;
    loading) echo "loading state" ;;
    stalled) echo "stalled for $(duration "$age")" ;;
    caught_up) echo "caught up" ;;
    catching_up)
      awk -v b="$behind" -v r="$rate" 'BEGIN {
        gain = r - 1 / 3
        if (gain <= 0) { printf "catching up (%.1f blocks/s, not gaining)\n", r; exit }
        s = int(b / gain); d = int(s / 86400); hh = int(s % 86400 / 3600); m = int(s % 3600 / 60)
        eta = d > 0 ? sprintf("%dd %dh", d, hh) : hh > 0 ? sprintf("%dh %dm", hh, m) : sprintf("%dm %ds", m, s % 60)
        printf "catching up (%.1f blocks/s, ~%s left)\n", r, eta
      }' ;;
  esac
}

# The chain head the validator last saw and how far behind it is.
head_summary() {
  sync_state
  case "$sync" in
    unknown | loading) echo "-" ;;
    stalled) echo "$head ($behind behind when last seen)" ;;
    *) echo "$head ($behind behind)" ;;
  esac
}

cmd_logs() {
  follow=""
  n=100
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) follow=1 ;;
      -n) n=$2; shift ;;
      *) die "usage: spud logs [-f] [-n N]" ;;
    esac
    shift
  done
  case "$SERVICE" in
    docker) dc logs --no-log-prefix --tail "$n" ${follow:+-f} validator ;;
    systemd) journalctl --user -u "$UNIT" -n "$n" ${follow:+-f} ;;
    *) tail -n "$n" ${follow:+-f} "$STATE_DIR/spudsps.log" ;;
  esac
}

account_list() {
  accounts=$(env_get VALIDATOR_ACCOUNTS)
  if [ -z "$accounts" ]; then echo "no validator accounts"; else printf '%s\n' "$accounts" | tr ',' '\n'; fi
}

cmd_accounts() {
  account_list
  echo "posting keys set: $(list_count "$(env_get VALIDATOR_KEY)")"
}

valid_account() { printf '%s' "$1" | grep -Eq '^[a-z][a-z0-9.-]{2,15}$'; }

# read_tty <prompt> [secret]: read a line from the terminal into $reply, one character at a time so
# Escape cancels. Ctrl-C also cancels. With "secret" nothing is echoed. The terminal is restored on exit.
read_tty() {
  [ -r /dev/tty ] || die "no terminal to read from"
  printf '%s' "$1" > /dev/tty
  tty_saved=$(stty -g < /dev/tty)
  trap 'stty "$tty_saved" < /dev/tty; printf "\n" > /dev/tty; exit 130' INT TERM
  stty -icanon -echo min 1 time 0 < /dev/tty
  reply=""
  esc=$(printf '\033')
  bs=$(printf '\177')
  bh=$(printf '\010')
  eot=$(printf '\004')
  while :; do
    c=$(dd bs=1 count=1 2>/dev/null < /dev/tty)
    case "$c" in
      "" | "$(printf '\r')") break ;;
      "$esc" | "$eot") stty "$tty_saved" < /dev/tty; trap - INT TERM; printf '\n' > /dev/tty; reply=""; exit 130 ;;
      "$bs" | "$bh")
        if [ -n "$reply" ]; then
          reply=${reply%?}
          [ "${2:-}" = secret ] || printf '\b \b' > /dev/tty
        fi ;;
      *)
        reply="$reply$c"
        [ "${2:-}" = secret ] || printf '%s' "$c" > /dev/tty ;;
    esac
  done
  stty "$tty_saved" < /dev/tty
  trap - INT TERM
  printf '\n' > /dev/tty
}

cmd_add() {
  usage_add="usage: spud add [<account>] [<posting key> | --no-key]"
  name=""
  key=""
  no_key=""
  for arg in "$@"; do
    case "$arg" in
      --no-key) no_key=1 ;;
      -*) die "$usage_add" ;;
      *)
        if [ -z "$name" ]; then name=$arg
        elif [ -z "$key" ]; then key=$arg
        else die "$usage_add"; fi ;;
    esac
  done
  [ -n "$no_key" ] && [ -n "$key" ] && die "$usage_add"
  accounts=$(env_get VALIDATOR_ACCOUNTS)
  keys=$(env_get VALIDATOR_KEY)
  if [ -z "$name" ]; then
    read_tty "Account: "
    name=$(printf '%s' "$reply" | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]')
    reply=""
    [ -n "$name" ] || die "an account is required"
  fi
  valid_account "$name" || die "not a Hive account name: $name"
  list_has "$accounts" "$name" && die "$name is already configured"
  if [ -z "$no_key" ] && [ -z "$key" ]; then
    if [ -n "$keys" ]; then read_tty "Posting key for $name (Enter to use an existing key): " secret
    else read_tty "Posting key for $name: " secret; fi
    key=$reply
    reply=""
  fi
  key=$(printf '%s' "$key" | tr -d '[:space:]')
  if [ -n "$key" ]; then
    printf '%s' "$key" | grep -Eq '^5[1-9A-HJ-NP-Za-km-z]{50}$' || die "Not a Hive posting key (starting with '5')"
    if ! list_has "$keys" "$key"; then
      SPUD_VALUE="${keys:+$keys,}$key"
      export SPUD_VALUE
      env_set VALIDATOR_KEY
      unset SPUD_VALUE
    fi
  elif [ -z "$keys" ]; then
    [ -n "$no_key" ] || die "no posting key is configured yet; one is required"
    say "No posting key is configured; the validator cannot start until one is (spud config)"
  fi
  key=""
  keys=""
  SPUD_VALUE="${accounts:+$accounts,}$name"
  export SPUD_VALUE
  env_set VALIDATOR_ACCOUNTS
  unset SPUD_VALUE
  say "Added $name"
  restart_and_report "$(env_get VALIDATOR_ACCOUNTS | tr ',' ' ')"
}

cmd_remove() {
  if [ $# -eq 0 ]; then
    printf '\033[31merror:\033[0m %s\n' "usage: spud remove <account>" >&2
    account_list >&2
    exit 1
  fi
  [ $# -eq 1 ] || die "usage: spud remove <account>"
  accounts=$(env_get VALIDATOR_ACCOUNTS)
  list_has "$accounts" "$1" || die "$1 is not configured"
  SPUD_VALUE=$(printf '%s\n' "$accounts" | tr ',' '\n' | grep -vx "$1" | paste -sd, -)
  export SPUD_VALUE
  env_set VALIDATOR_ACCOUNTS
  unset SPUD_VALUE
  say "Removed $1 (its key stays in .env; spud config to remove it)"
  rest=$(env_get VALIDATOR_ACCOUNTS | tr ',' ' ')
  if [ -n "$rest" ]; then restart_and_report "$rest"; else quiet_restart && say "Restarted (no accounts)"; fi
}

cmd_config() {
  before=$(cksum < "$ENV")
  ${VISUAL:-${EDITOR:-vi}} "$ENV"
  chmod 600 "$ENV"
  if [ "$(cksum < "$ENV")" = "$before" ]; then say "No changes"; return; fi
  accounts=$(env_get VALIDATOR_ACCOUNTS | tr ',' ' ')
  if [ -n "$accounts" ]; then restart_and_report "$accounts"; else quiet_restart && say "Restarted"; fi
}

# ------------------------------------------------------------------ snapshots
# Data paths as the validator sees them (/data inside the container) and as they are on this host.
if [ "$MODE" = docker ]; then
  SNAP_HOST="$DIR/data/snapshots" SNAP_RUN=/data/snapshots CKPT_HOST="$DIR/data/checkpoints" CKPT_RUN=/data/checkpoints
else
  SNAP_HOST=$(env_get SNAPSHOT_DIR) CKPT_HOST=$(env_get CHECKPOINT_DIR)
  SNAP_RUN=$SNAP_HOST CKPT_RUN=$CKPT_HOST
fi

json_field() { sed -n "s/^ *\"$1\": *\"\{0,1\}\([^\",]*\).*/\1/p" "$2" | head -n 1; }
mb() { awk -v b="$1" 'BEGIN { printf "%.0f MB", b / 1048576 }'; }

# Run the validator CLI against the install's data (a one-off container for docker).
validator_cli() {
  case "$MODE" in
    docker) dc run --rm --no-deps -T validator node packages/validator/dist/cli.mjs "$@" ;;
    native) "$BIN" "$@" ;;
  esac
}

cmd_snapshot() {
  case "${1:-}" in
    "") ;;
    now) snapshot_now; return ;;
    *) die "usage: spud snapshot [now]" ;;
  esac
  [ -n "$SNAP_HOST" ] || die "SNAPSHOT_DIR is not set in $ENV; snapshots are off"
  every=$(env_get SNAPSHOT_EVERY); every=${every:-28800}
  keep=$(env_get SNAPSHOT_KEEP); keep=${keep:-3}
  printf 'directory %s\n' "$SNAP_HOST"
  printf 'schedule  every %s blocks (about %s h at 3 s a block), newest %s kept\n' "$every" "$((every * 3 / 3600))" "$keep"
  found=""
  for m in "$SNAP_HOST"/seed-*.manifest.json; do
    [ -f "$m" ] || continue
    found=1
    printf '  %s  block %s  %s  %s\n' "$(json_field file "$m" | sed 's#.*/##')" "$(json_field block_num "$m")" "$(mb "$(json_field bytes "$m")")" "$(json_field exported_at "$m")"
  done
  [ -n "$found" ] || echo "  none yet"
  hashes="$STATE_DIR/hashes.log"
  if [ -s "$hashes" ]; then
    block=$(tail -n 1 "$hashes" | cut -d' ' -f1)
    next=$(((block / every + 1) * every))
    printf 'next      block %s (in about %s min)\n' "$next" "$(((next - block) * 3 / 60))"
  fi
}

snapshot_now() {
  [ -n "$SNAP_HOST" ] || die "SNAPSHOT_DIR is not set in $ENV"
  [ -n "$CKPT_HOST" ] || die "CHECKPOINT_DIR is not set in $ENV"
  block=$(ls "$CKPT_HOST" 2>/dev/null | sed -n 's/^checkpoint-0*\([0-9][0-9]*\)\.v8\.gz$/\1/p' | sort -n | tail -n 1)
  [ -n "$block" ] || die "no checkpoints in $CKPT_HOST yet"
  name="seed-$(printf '%010d' "$block").ndjson.gz"
  [ -f "$SNAP_HOST/$name" ] && { say "$name already exists"; return; }
  mkdir -p "$SNAP_HOST"
  say "Exporting block $block from the newest checkpoint (about a minute, verified by reloading it)"
  out=$(validator_cli export "$CKPT_RUN" "$SNAP_RUN/$name" "$block" --verify 2>&1) || { printf '%s\n' "$out" >&2; die "export failed"; }
  m="$SNAP_HOST/${name%.ndjson.gz}.manifest.json"
  say "Wrote $SNAP_HOST/$name ($(mb "$(json_field bytes "$m")"), sha256 $(json_field sha256 "$m"))"
}

latest_tag() {
  if [ -n "${RELEASE_BASE:-}" ]; then
    curl -fsSL "$RELEASE_BASE/RELEASE" 2>/dev/null | head -n 1 | tr -d '[:space:]'
  else
    curl -fsSIL -o /dev/null -w '%{url_effective}' "https://github.com/${REPO}/releases/latest" 2>/dev/null | sed -n 's#.*/releases/tag/##p'
  fi
}

cmd_version() {
  printf 'install   %s (%s, %s)\n' "$TAG" "$MODE" "$DIR"
  case "$MODE" in
    docker)
      image=$(docker inspect -f '{{.Image}}' spudsps 2>/dev/null || true)
      v=""
      [ -n "$image" ] && v=$(docker image inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$image" 2>/dev/null || true)
      printf 'image     %s%s\n' "$IMAGE:$TAG" "${v:+ ($v)}" ;;
    native) printf 'cli       %s\n' "$("$BIN" version 2>/dev/null || echo "not found: $BIN")" ;;
  esac
}

# get_installer <version>: download that release's install.sh (empty = latest) to $work and verify it.
get_installer() {
  if [ -n "${RELEASE_BASE:-}" ]; then base=$RELEASE_BASE
  elif [ -n "$1" ]; then base="https://github.com/${REPO}/releases/download/$1"
  else base="https://github.com/${REPO}/releases/latest/download"; fi
  work="$DIR/cache/update"
  mkdir -p "$work"
  curl -fsSL --retry 3 -o "$work/install.sh" "$base/install.sh" || die "download failed: $base/install.sh"
  curl -fsSL --retry 3 -o "$work/SHA256SUMS" "$base/SHA256SUMS" || die "download failed: $base/SHA256SUMS"
  expected=$(grep ' install.sh$' "$work/SHA256SUMS" | cut -d' ' -f1)
  [ -n "$expected" ] || die "install.sh is not listed in SHA256SUMS"
  if command -v sha256sum >/dev/null 2>&1; then actual=$(sha256sum "$work/install.sh" | cut -d' ' -f1)
  else actual=$(shasum -a 256 "$work/install.sh" | cut -d' ' -f1); fi
  [ "$actual" = "$expected" ] || die "checksum mismatch for install.sh"
}

cmd_update() {
  version=""
  check=""
  auto=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) version=$2; shift ;;
      --check) check=1 ;;
      --auto) auto=1 ;;
      *) die "usage: spud update [--version TAG] [--check | --auto]" ;;
    esac
    shift
  done
  if [ -n "$auto" ]; then auto_update; return; fi
  if [ -n "$check" ]; then
    latest=$(latest_tag)
    [ -n "$latest" ] || { ulog "check failed: could not read the latest release"; exit 1; }
    if [ "$latest" = "$TAG" ]; then ulog "up to date ($TAG)"; else ulog "update available: $TAG -> $latest (spud update)"; fi
    return
  fi
  get_installer "$version"
  say "Running the installer from ${version:-the latest release}"
  # The installer replaces this file (a new file renamed into place), so nothing runs after exec.
  exec sh "$work/install.sh" --update --dir "$DIR" ${version:+--version "$version"}
}

# ------------------------------------------------------------------ auto-update
UPDATE_LOG="$STATE_DIR/update.log"
ROLLBACK="$DIR/cache/rollback"
LOCK="$DIR/cache/update.lock"
AU_LABEL="com.spudsps.validator.update"
AU_PLIST="$HOME/Library/LaunchAgents/$AU_LABEL.plist"
AU_UNIT="spudsps-update"
AU_SYSTEMD="$HOME/.config/systemd/user"
AU_MARK="# spudsps auto-update $DIR"

# ulog <message>: append to state/update.log (and print, unless run by the scheduler).
ulog() {
  mkdir -p "$STATE_DIR"
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$UPDATE_LOG"
  [ -n "${SPUD_AUTO:-}" ] || say "$*"
}

svc_running() { case "$(svc_state)" in running* | active) return 0 ;; esac; return 1; }
last_block() { if [ -s "$STATE_DIR/hashes.log" ]; then tail -n 1 "$STATE_DIR/hashes.log" | cut -d' ' -f1; else echo 0; fi; }

take_lock() {
  mkdir -p "$DIR/cache"
  mkdir "$LOCK" 2>/dev/null || die "another update is running (remove $LOCK if it is not)"
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
}
drop_lock() { rmdir "$LOCK" 2>/dev/null || true; trap - EXIT; }

# Keep what is needed to return to the installed release without downloading it again.
save_rollback() {
  rm -rf "${ROLLBACK:?}"
  mkdir -p "$ROLLBACK"
  cp "$DIR/install.conf" "$DIR/bin/spud" "$ROLLBACK/"
  [ -f "$DIR/docker-compose.yml" ] && cp "$DIR/docker-compose.yml" "$ROLLBACK/"
  [ -f "$DIR/cache/spudsps.tgz" ] && cp "$DIR/cache/spudsps.tgz" "$ROLLBACK/"
  return 0
}

# rollback <failed-tag> <previous-tag>: restore the saved install and restart; <failed-tag> is not retried.
rollback() {
  [ -f "$ROLLBACK/install.conf" ] || { ulog "rollback to $2 failed: nothing saved in $ROLLBACK"; return 1; }
  cp "$ROLLBACK/install.conf" "$DIR/install.conf"
  [ -f "$ROLLBACK/docker-compose.yml" ] && cp "$ROLLBACK/docker-compose.yml" "$DIR/docker-compose.yml"
  if [ "$MODE" = native ] && [ -f "$ROLLBACK/spudsps.tgz" ]; then
    cp "$ROLLBACK/spudsps.tgz" "$DIR/cache/spudsps.tgz"
    npm install --global "$DIR/cache/spudsps.tgz" >> "$UPDATE_LOG" 2>&1 || ulog "rollback: npm install of $2 failed"
  fi
  cp "$ROLLBACK/spud" "$DIR/bin/spud.new" && chmod 755 "$DIR/bin/spud.new" && mv "$DIR/bin/spud.new" "$DIR/bin/spud"
  printf '%s\n' "$1" > "$STATE_DIR/update.skip"
  if svc_restart >> "$UPDATE_LOG" 2>&1; then ulog "rolled back to $2; $1 will not be retried"
  else ulog "rolled back to $2, but the restart failed (spud logs)"; fi
  return 1
}

auto_update() {
  [ "$(env_get AUTO_UPDATE)" = 0 ] && { say "auto-update is off (AUTO_UPDATE=0)"; return 0; }
  take_lock
  latest=$(latest_tag)
  [ -n "$latest" ] || { ulog "check failed: could not read the latest release"; return 1; }
  [ "$latest" = "$TAG" ] && { ulog "up to date ($TAG)"; return 0; }
  if [ "$latest" = "$(cat "$STATE_DIR/update.skip" 2>/dev/null || true)" ]; then
    ulog "skipping $latest (rolled back earlier)"
    return 0
  fi
  prev=$TAG
  running=""
  nostart="--no-start"
  svc_running && { running=1; nostart=""; }
  save_rollback
  ulog "updating $prev -> $latest"
  get_installer "$latest"
  if ! SPUD_AUTO=1 sh "$work/install.sh" --update --dir "$DIR" --version "$latest" $nostart >> "$UPDATE_LOG" 2>&1; then
    ulog "installer for $latest failed (see $UPDATE_LOG)"
    rollback "$latest" "$prev"
    return 1
  fi
  if [ -z "$running" ]; then ulog "updated to $latest (the service was stopped, so it was not started)"; return 0; fi
  drop_lock
  # Check the result with the new spud.
  exec "$DIR/bin/spud" _check-update "$prev" "$latest"
}

# _check-update <prev> <new>: the restarted validator must process past where it was, or roll back.
# The previous release execs this in the new one, so keep the name and arguments stable.
cmd_check_update() {
  take_lock
  wait_s=$(env_get AUTO_UPDATE_CHECK_SECONDS)
  wait_s=${wait_s:-600}
  start=$(last_block)
  deadline=$(($(date +%s) + wait_s))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    now=$(last_block)
    if svc_running && [ "$now" -gt "$start" ]; then
      rm -f "${STATE_DIR:?}/update.skip"
      ulog "updated to $2: processing blocks (block $now)"
      return 0
    fi
    sleep 10
  done
  ulog "$2 processed no new blocks within ${wait_s}s"
  rollback "$2" "$1"
}

# --- scheduler: launchd on macOS, a systemd user timer on Linux, otherwise cron
au_kind() {
  case "$(uname -s)" in
    Darwin) echo launchd ;;
    *)
      if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then echo systemd
      elif command -v crontab >/dev/null 2>&1; then echo cron
      else echo none; fi ;;
  esac
}

# A daily time picked once per install, so installs do not all update at the same moment.
au_time() {
  f="$STATE_DIR/update.at"
  if [ ! -s "$f" ]; then
    mkdir -p "$STATE_DIR"
    awk -v s="$$$(date +%s)" 'BEGIN { srand(s % 2147483647); printf "%d %d\n", int(rand() * 60), int(rand() * 24) }' > "$f"
  fi
  cat "$f"
}

xml() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

au_install() {
  kind=$(au_kind)
  set -- $(au_time)
  min=$1 hour=$2
  spud_bin="$DIR/bin/spud"
  case "$kind" in
    launchd)
      mkdir -p "$(dirname "$AU_PLIST")"
      new="$AU_PLIST.new"
      cat > "$new" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$AU_LABEL</string>
  <key>ProgramArguments</key><array><string>$(xml "$spud_bin")</string><string>update</string><string>--auto</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>$(xml "$PATH")</string><key>SPUD_AUTO</key><string>1</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>$hour</integer><key>Minute</key><integer>$min</integer></dict>
  <key>StandardOutPath</key><string>$(xml "$UPDATE_LOG")</string>
  <key>StandardErrorPath</key><string>$(xml "$UPDATE_LOG")</string>
</dict>
</plist>
EOF
      if [ -f "$AU_PLIST" ] && cmp -s "$new" "$AU_PLIST" && launchctl print "gui/$UID_/$AU_LABEL" >/dev/null 2>&1; then
        rm -f "${new:?}"
      elif [ -n "${SPUD_AUTO:-}" ]; then
        # Running from the scheduled job itself: unloading it would stop this update. The new
        # file is loaded at the next login.
        mv "$new" "$AU_PLIST"
      else
        mv "$new" "$AU_PLIST"
        launchctl bootout "gui/$UID_/$AU_LABEL" 2>/dev/null || true
        launchctl bootstrap "gui/$UID_" "$AU_PLIST"
      fi ;;
    systemd)
      mkdir -p "$AU_SYSTEMD"
      cat > "$AU_SYSTEMD/$AU_UNIT.service" <<EOF
[Unit]
Description=Spud auto-update

[Service]
Type=oneshot
Environment="PATH=$PATH" SPUD_AUTO=1
ExecStart="$spud_bin" update --auto
EOF
      cat > "$AU_SYSTEMD/$AU_UNIT.timer" <<EOF
[Unit]
Description=Daily Spud auto-update

[Timer]
OnCalendar=*-*-* $(printf '%02d:%02d' "$hour" "$min"):00
Persistent=true

[Install]
WantedBy=timers.target
EOF
      systemctl --user daemon-reload
      systemctl --user enable --now "$AU_UNIT.timer" >/dev/null 2>&1 ;;
    cron)
      line="$min $hour * * * PATH='$PATH' SPUD_AUTO=1 '$spud_bin' update --auto >> '$UPDATE_LOG' 2>&1 $AU_MARK"
      { crontab -l 2>/dev/null | grep -vF "$AU_MARK" || true; echo "$line"; } | crontab - ;;
    *) warn "no launchd, systemd or cron here; run spud update --auto yourself"; return 1 ;;
  esac
}

au_remove() {
  case "$(au_kind)" in
    launchd)
      launchctl bootout "gui/$UID_/$AU_LABEL" 2>/dev/null || true
      rm -f "${AU_PLIST:?}" ;;
    systemd)
      systemctl --user disable --now "$AU_UNIT.timer" >/dev/null 2>&1 || true
      rm -f "${AU_SYSTEMD:?}/${AU_UNIT:?}.service" "${AU_SYSTEMD:?}/${AU_UNIT:?}.timer"
      systemctl --user daemon-reload || true ;;
    cron)
      if crontab -l 2>/dev/null | grep -qF "$AU_MARK"; then
        crontab -l 2>/dev/null | grep -vF "$AU_MARK" | crontab -
      fi ;;
  esac
  return 0
}

au_installed() {
  case "$(au_kind)" in
    launchd) [ -f "$AU_PLIST" ] ;;
    systemd) [ -f "$AU_SYSTEMD/$AU_UNIT.timer" ] ;;
    cron) crontab -l 2>/dev/null | grep -qF "$AU_MARK" ;;
    *) return 1 ;;
  esac
}

auto_update_summary() {
  if [ "$(env_get AUTO_UPDATE)" = 0 ]; then state="off"
  elif au_installed; then
    set -- $(au_time)
    state=$(printf 'on (%s, daily at %02d:%02d local)' "$(au_kind)" "$2" "$1")
  else state="on in .env, but not scheduled (spud auto-update on)"; fi
  last=$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T' "$UPDATE_LOG" 2>/dev/null | tail -n 1 || true)
  printf '%s%s' "$state" "${last:+; last: $last}"
}

# The Update row of spud status.
update_summary() {
  hint='run `spud auto-update on` to update automatically'
  if [ "$(env_get AUTO_UPDATE)" = 0 ]; then printf 'off (%s)' "$hint"; return; fi
  au_installed || { printf 'not scheduled (%s)' "$hint"; return; }
  set -- $(au_time)
  printf 'automatically (daily at %02d:%02d local via %s)' "$2" "$1" "$(au_kind)"
}

# ago <seconds>: just now, 1 minute ago, 2 hours ago, 3 days ago
ago() {
  awk -v s="$1" 'BEGIN {
    if (s < 60) { print "just now"; exit }
    if (s < 3600) { n = int(s / 60); u = "minute" } else if (s < 86400) { n = int(s / 3600); u = "hour" } else { n = int(s / 86400); u = "day" }
    printf "%d %s%s ago\n", n, u, (n == 1 ? "" : "s")
  }'
}

# The Checked row of spud status: the last update check (scheduled or spud update --check) and its result.
checked_summary() {
  last=$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z ' "$UPDATE_LOG" 2>/dev/null | tail -n 1 || true)
  [ -n "$last" ] || { echo "never (spud update --check)"; return; }
  ts=${last%% *}
  epoch=$(date -u -d "$ts" +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$ts" +%s 2>/dev/null || true)
  if [ -n "$epoch" ]; then printf '%s (%s) %s\n' "$(ago $(($(date +%s) - epoch)))" "$ts" "${last#* }"
  else printf '%s %s\n' "$ts" "${last#* }"; fi
}

cmd_auto_update() {
  case "${1:-}" in
    "") auto_update_summary; echo; echo "log: $UPDATE_LOG" ;;
    on)
      SPUD_VALUE=1; export SPUD_VALUE; env_set AUTO_UPDATE; unset SPUD_VALUE
      au_install && say "Auto-update $(auto_update_summary)" ;;
    off)
      SPUD_VALUE=0; export SPUD_VALUE; env_set AUTO_UPDATE; unset SPUD_VALUE
      au_remove
      say "Auto-update off" ;;
    sync) # used by install.sh: match the scheduler to AUTO_UPDATE in .env
      if [ "$(env_get AUTO_UPDATE)" = 0 ]; then au_remove; say "Auto-update off (AUTO_UPDATE=0)"
      else au_install && say "Auto-update $(auto_update_summary)"; fi ;;
    *) die "usage: spud auto-update [on|off]" ;;
  esac
}

cmd_uninstall() {
  purge=""
  [ "${1:-}" = "--purge" ] && purge=1
  if [ -n "$purge" ]; then prompt="Remove the service, spud and everything in $DIR (including data)? [y/N] "
  else prompt="Remove the service and spud (keep $DIR)? [y/N] "; fi
  printf '%s' "$prompt"
  read -r answer < /dev/tty || answer=""
  case "$answer" in y | Y | yes) ;; *) say "Nothing removed"; return ;; esac
  case "$SERVICE" in
    docker) dc down || true ;;
    systemd) systemctl --user disable --now "$UNIT" 2>/dev/null || true; rm -f "$HOME/.config/systemd/user/$UNIT.service"; systemctl --user daemon-reload || true ;;
    launchd) launchctl bootout "gui/$UID_/$LABEL" 2>/dev/null || true; rm -f "$PLIST" ;;
  esac
  au_remove
  [ "$MODE" = native ] && { npm uninstall --global @spudsps/validator >/dev/null 2>&1 || true; }
  link="$HOME/.local/bin/spud"
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$DIR/bin/spud" ]; then rm -f "$link"; fi
  if [ -n "$purge" ]; then
    case "$DIR" in "" | / | "$HOME") die "refusing to delete $DIR" ;; esac
    rm -rf "$DIR"
    say "Removed $DIR"
  else
    rm -f "$DIR/bin/spud"
    say "Removed the service and spud; $DIR is kept"
  fi
}

if [ $# -eq 0 ]; then
  cmd_status
  printf '\nRun `spud help` for more commands\n'
  exit 0
fi
cmd=$1
shift
case "$cmd" in
  status) cmd_status ;;
  logs) cmd_logs "$@" ;;
  start) svc_start ;;
  stop) svc_stop ;;
  restart) svc_restart ;;
  accounts) cmd_accounts ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  config) cmd_config ;;
  version) cmd_version ;;
  update) cmd_update "$@" ;;
  auto-update) cmd_auto_update "$@" ;;
  _check-update) cmd_check_update "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  help | -h | --help) usage ;;
  *) usage >&2; exit 2 ;;
esac
