{
  "name": "@spsdao/mini-validator",
  "version": "0.3.0",
  "private": true,
  "description": "Minimal SPS validator: replays Hive blocks in memory, computes L2 block hashes and performs validator duties",
  "type": "module",
  "exports": {
    ".": "./src/lib.mts",
    "./lib": "./src/lib.mts",
    "./services": "./src/services.mts",
    "./state": "./src/state/index.mts",
    "./bootstrap/seed": "./src/bootstrap/seed.mts",
    "./block/processor": "./src/block/processor.mts",
    "./config": "./src/config.mts",
    "./types": "./src/types.mts"
  },
  "bin": {
    "sps-mini-validator": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.mjs', 0o755)\"",
    "clean": "rimraf dist",
    "dbdiff": "node --import tsx tools/dbdiff.mts",
    "dev": "node --import tsx src/main.mts",
    "diff-block": "node --import tsx tools/diff-block.mts",
    "export-seed": "node --import tsx src/cli.mts export",
    "extract-seed": "tsx tools/extract-seed.mts",
    "lint": "eslint 'src/**/*.mts'",
    "sort": "sort-package-json",
    "start": "node dist/main.mjs",
    "start:check": "node dist/check.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.2.0",
    "@scure/base": "^2.4.0",
    "js-sha256": "^0.11.0",
    "pg": "^8.23.1",
    "seedrandom": "^3.0.5",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@hiveio/dhive": "^1.3.6",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/seedrandom": "^3.0.8",
    "pg-cursor": "^2.22.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
