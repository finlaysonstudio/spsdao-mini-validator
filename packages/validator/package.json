{
  "name": "@spsdao/validator",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal SPS validator observer: replays Hive blocks in memory and computes L2 block hashes",
  "type": "module",
  "exports": {
    "./services": "./src/services.mts",
    "./state": "./src/state/index.mts",
    "./bootstrap/seed": "./src/bootstrap/seed.mts",
    "./block/processor": "./src/block/processor.mts",
    "./config": "./src/config.mts",
    "./types": "./src/types.mts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dbdiff": "tsx tools/dbdiff.mts",
    "dev": "tsx src/main.mts",
    "diff-block": "tsx tools/diff-block.mts",
    "extract-seed": "tsx tools/extract-seed.mts",
    "lint": "eslint 'src/**/*.mts'",
    "prebuild": "npm run clean",
    "sort": "sort-package-json",
    "start": "node dist/main.mjs",
    "start:check": "node dist/check.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-sha256": "^0.11.0",
    "pg": "^8.23.1",
    "seedrandom": "^3.0.5",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/seedrandom": "^3.0.8",
    "pg-cursor": "^2.22.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
